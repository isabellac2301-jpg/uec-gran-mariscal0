---
import '../styles/global.css';
import Header from '../components/Header.astro';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Actividades | U.E.C Gran Mariscal de Ayacucho</title>
</head>
<body>
  <Header />
  <main class="container">
    <h1>Actividades y Eventos</h1>
    
    <ul class="lista-eventos">
      <li>
        <strong>Feria de Ciencias y Creatividad</strong><br>
        <span class="fecha">Fecha: [PLACEHOLDER] Noviembre</span>
        <p>Exposición de proyectos realizados por los estudiantes de Primaria y Bachillerato.</p>
      </li>
      <li>
        <strong>Festival Navideño</strong><br>
        <span class="fecha">Fecha: [PLACEHOLDER] Diciembre</span>
        <p>Celebración con villancicos, pesebres vivientes y compartir entre las familias.</p>
      </li>
    </ul>
  </main>
</body>
</html>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: var(--space-5) var(--space-2); }
  h1 { margin-bottom: var(--space-4); }
  .lista-eventos { list-style: none; padding: 0; }
  .lista-eventos li { background: var(--color-bg-alt); padding: var(--space-3); margin-bottom: var(--space-3); border-radius: 8px; border-left: 4px solid var(--color-secondary); }
  .lista-eventos strong { font-size: 1.2rem; color: var(--color-primary); }
  .fecha { display: block; margin: var(--space-1) 0; color: var(--color-accent-red); font-weight: bold; font-size: 0.9rem; }
</style>