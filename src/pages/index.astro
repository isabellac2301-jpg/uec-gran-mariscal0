---
import '../styles/global.css';
import Header from '../components/Header.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Sitio oficial de la U.E.C Gran Mariscal de Ayacucho en Yaguaraparo, Sucre." />
  <title>Inicio | U.E.C Gran Mariscal de Ayacucho</title>
</head>
<body>
  <Header />

  <main id="main-content">
    <!-- Sección de Bienvenida (Hero con la foto de la fachada) -->
    <section class="hero">
      <h1>U.E.C Gran Mariscal de Ayacucho</h1>
      <p>"Lámpara es a mis pies tu palabra y lumbrera a mi camino"</p>
    </section>

    <!-- Sección de Bienvenida breve -->
    <section class="container">
      <h2>Bienvenidos a nuestro Colegio</h2>
      <p style="margin-top: 1rem;">Somos una institución educativa ubicada en Yaguaraparo, Estado Sucre, dedicada a la formación integral de nuestros estudiantes desde 2022.</p>
    </section>

    <!-- Sección de FAQs -->
    <section class="container">
      <FAQ />
    </section>

    <!-- Sección de Contacto -->
    <section class="container">
      <h2>Contáctanos</h2>
      <ContactForm />
    </section>
  </main>

  <footer>
    <p>&copy; 2024 U.E.C Gran Mariscal de Ayacucho. Todos los derechos reservados.</p>
    <p>Yaguaraparo, Estado Sucre - Venezuela</p>
  </footer>
</body>
</html>

<style>
  .hero {
    /* Color azul de respaldo por si la imagen tarda en cargar */
    background-color: #17255A;
    
    /* Degradado + TU IMAGEN DE LA FACHADA */
    background-image: linear-gradient(to bottom, rgba(23, 37, 90, 0.2) 0%, rgba(23, 37, 90, 0.8) 60%, rgba(23, 37, 90, 1) 100%), url('https://raw.githubusercontent.com/isabellac2301-jpg/Imagenes-web./main/IMG-20261126-WA0020.jpg');
    
    background-size: cover;
    background-position: center top; /* Enfoca desde arriba para no cortar el techo */
    background-repeat: no-repeat;
    color: white;
    padding: 4rem 1rem;
    text-align: center;
    min-height: 85vh; /* Ocupa el 85% de la pantalla del celular */
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  
  .hero h1 {
    color: white;
    font-size: 2.5rem;
    margin-bottom: 1rem;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.5); /* Sombra al texto para que resalte más */
  }
  
  .hero p {
    font-size: 1.2rem;
    font-style: italic;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.5); /* Sombra al lema */
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1rem;
  }
  
  footer {
    background-color: #17255A;
    color: white;
    text-align: center;
    padding: 1.5rem;
    margin-top: 2rem;
  }

  /* Adaptación para Computadoras y Tablets */
  @media (min-width: 768px) {
    .hero {
      min-height: 90vh; /* En computadora ocupa el 90% de la pantalla */
      /* Ajustamos el degradado para pantallas grandes */
      background-image: linear-gradient(to bottom, rgba(23, 37, 90, 0.1) 0%, rgba(23, 37, 90, 0.7) 70%, rgba(23, 37, 90, 1) 100%), url('https://raw.githubusercontent.com/isabellac2301-jpg/Imagenes-web./main/IMG-20261126-WA0020.jpg');
    }
    .hero h1 {
      font-size: 3.5rem; /* Título más grande en computadora */
    }
  }
</style>