---
import '../styles/global.css';
import Header from '../components/Header.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro'; 
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Sitio oficial de la U.E.C Gran Mariscal de Ayacucho en Yaguaraparo, Sucre." />
  <title>Inicio | U.E.C Gran Mariscal de Ayacucho</title>
</head>
<body>
  <Header />

  <main id="main-content">
    <section class="hero">
      <h1>U.E.C Gran Mariscal de Ayacucho</h1>
      <p>"Lámpara es a mis pies tu palabra y lumbrera a mi camino"</p>
    </section>

    <section class="container">
      <h2>Bienvenidos a nuestro Colegio</h2>
      <p style="margin-top: 1rem;">Somos una institución educativa ubicada en Yaguaraparo, Estado Sucre, dedicada a la formación integral de nuestros estudiantes desde 2022.</p>
    </section>

    <section class="container">
      <FAQ />
    </section>

    <section class="container">
      <h2>Contáctanos</h2>
      <ContactForm />
    </section>
  </main>

  <Footer />
  
</body>
</html>

<style>
  .hero {
    background-color: #17255A;
    background-image: linear-gradient(to bottom, rgba(23, 37, 90, 0.2) 0%, rgba(23, 37, 90, 0.8) 60%, rgba(23, 37, 90, 1) 100%), url('https://raw.githubusercontent.com/isabellac2301-jpg/Imagenes-web./main/IMG-20261126-WA0020.jpg');
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    color: white;
    padding: 4rem 1rem;
    text-align: center;
    min-height: 85vh; 
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .hero h1 { color: white; font-size: 2.5rem; margin-bottom: 1rem; text-shadow: 2px 2px 4px rgba(0,0,0,0.5); }
  .hero p { font-size: 1.2rem; font-style: italic; text-shadow: 1px 1px 3px rgba(0,0,0,0.5); }
  .container { max-width: 1200px; margin: 0 auto; padding: 3rem 1rem; }
  
  @media (min-width: 768px) {
    .hero {
      min-height: 90vh;
      background-image: linear-gradient(to bottom, rgba(23, 37, 90, 0.1) 0%, rgba(23, 37, 90, 0.7) 70%, rgba(23, 37, 90, 1) 100%), url('https://raw.githubusercontent.com/isabellac2301-jpg/Imagenes-web./main/IMG-20261126-WA0020.jpg');
    }
    .hero h1 { font-size: 3.5rem; }
  }
</style>