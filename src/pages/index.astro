---
import '../styles/global.css';
import Header from '../components/Header.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Sitio oficial de la U.E.C Gran Mariscal de Ayacucho en Yaguaraparo, Sucre." />
  <title>Inicio | U.E.C Gran Mariscal de Ayacucho</title>
</head>
<body>
  <Header />

  <main id="main-content">
    <section class="hero">
      <h1>U.E.C Gran Mariscal de Ayacucho</h1>
      <p>"Lámpara es a mis pies tu palabra y lumbrera a mi camino"</p>
    </section>

    <section class="container">
      <h2>Bienvenidos a nuestro Colegio</h2>
      <p style="margin-top: 1rem;">Somos una institución educativa ubicada en Yaguaraparo, Estado Sucre, dedicada a la formación integral de nuestros estudiantes desde 2022.</p>
    </section>

    <section class="container">
      <FAQ />
    </section>

    <section class="container">
      <h2>Contáctanos</h2>
      <ContactForm />
    </section>
  </main>

  <footer>
    <p>&copy; 2024 U.E.C Gran Mariscal de Ayacucho. Todos los derechos reservados.</p>
    <p>Yaguaraparo, Estado Sucre - Venezuela</p>
  </footer>
</body>
</html>

<style>
   .hero {
  /* 1. Degradado: Empieza casi transparente (0.1) y se vuelve azul sólido (1) al 80% de la altura */
  background-image: linear-gradient(to bottom, rgba(23, 37, 90, 0.2) 0%, rgba(23, 37, 90, 0.8) 60%, rgba(23, 37, 90, 1) 100%), url('AQUI_PEGA_TU_URL_RAW');
  background-size: cover;
  
  /* 2. Esto enfoca la foto desde arriba, para que no corte el techo del colegio */
  background-position: center top; 
  
  background-repeat: no-repeat;
  color: white;
  padding: var(--space-6) var(--space-2);
  text-align: center;
  
  /* 3. Hacemos que la sección sea MÁS ALTA (85% de la pantalla del celular) */
  min-height: 85vh; 
  
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* 4. Adaptación para Computadoras y Tablets (cuando la pantalla es más ancha) */
@media (min-width: 768px) {
  .hero {
    min-height: 90vh; /* Ocupa casi toda la pantalla de la compu */
    /* En pantallas grandes la foto se ve completa, así que suavizamos el degradado */
    background-image: linear-gradient(to bottom, rgba(23, 37, 90, 0.1) 0%, rgba(23, 37, 90, 0.7) 70%, rgba(23, 37, 90, 1) 100%), url(https://raw.githubusercontent.com/isabellac2301-jpg/Imagenes-web./main/IMG-20261126-WA0020.jpg);
  }
}
  .hero h1 {
    color: white;
    font-size: 2.5rem;
    margin-bottom: var(--space-2);
  }
  .hero p {
    font-size: 1.2rem;
    font-style: italic;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-5) var(--space-2);
  }
  footer {
    background-color: var(--color-primary);
    color: white;
    text-align: center;
    padding: var(--space-3);
    margin-top: var(--space-4);
  }
</style>