---
import '../styles/global.css';
import Header from '../components/Header.astro';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Página no encontrada | U.E.C Gran Mariscal de Ayacucho</title>
</head>
<body>
  <Header />
  <main class="container">
    <h1>404 - Página no encontrada</h1>
    <p>Lo sentimos, la página que estás buscando no existe o fue movida.</p>
    <a href="/" class="btn">Volver al Inicio</a>
  </main>
</body>
</html>

<style>
  .container { max-width: 800px; margin: 0 auto; padding: var(--space-6) var(--space-2); text-align: center; }
  h1 { color: var(--color-accent-red); margin-bottom: var(--space-2); }
  p { margin-bottom: var(--space-4); font-size: 1.2rem; }
  .btn { display: inline-block; padding: var(--space-2) var(--space-4); background: var(--color-primary); color: white; text-decoration: none; font-weight: bold; border-radius: 4px; }
</style>